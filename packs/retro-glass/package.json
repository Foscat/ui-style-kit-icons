{
  "name": "retro-glass-ui-style-icons",
  "version": "0.2.0",
  "description": "Theme-aware retro-glass SVG icon pack for ui-style-kit-css and layout-style-css projects.",
  "files": [
    "dist",
    "icons",
    "sprite",
    "style-source",
    "manifest.json",
    "README.md",
    "LICENSE"
  ],
  "style": "dist/retro-glass-ui-style-icons.css",
  "exports": {
    ".": "./dist/retro-glass-ui-style-icons.css",
    "./css": "./dist/retro-glass-ui-style-icons.css",
    "./css.css": "./dist/retro-glass-ui-style-icons.css",
    "./sprite": "./dist/retro-glass-ui-style-icons.svg",
    "./sprite.svg": "./dist/retro-glass-ui-style-icons.svg",
    "./inline-sprite": "./sprite/retro-glass-ui-style-icons.inline.svg",
    "./manifest.json": "./manifest.json",
    "./icons/*": "./icons/*"
  },
  "keywords": [
    "css",
    "icons",
    "svg",
    "ui-style-kit",
    "retro-glass",
    "glassmorphism",
    "theme-aware"
  ],
  "license": "MIT"
}
