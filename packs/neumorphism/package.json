{
  "name": "neumorphism-ui-style-icons",
  "version": "1.0.0",
  "description": "Theme-aware Neumorphism SVG icon pack aligned to the UI Style Kit icon contract.",
  "files": [
    "dist",
    "icons",
    "sprite",
    "style-source",
    "manifest.json",
    "README.md",
    "LICENSE"
  ],
  "style": "dist/neumorphism-ui-style-icons.css",
  "exports": {
    ".": "./dist/neumorphism-ui-style-icons.css",
    "./css": "./dist/neumorphism-ui-style-icons.css",
    "./css.css": "./dist/neumorphism-ui-style-icons.css",
    "./sprite": "./dist/neumorphism-ui-style-icons.svg",
    "./sprite.svg": "./dist/neumorphism-ui-style-icons.svg",
    "./inline-sprite": "./sprite/neumorphism-ui-style-icons.inline.svg",
    "./manifest.json": "./manifest.json",
    "./icons/*": "./icons/*"
  },
  "keywords": [
    "svg",
    "icons",
    "neumorphism",
    "neomorphic",
    "ui-style-kit-css",
    "theme-aware"
