{
  "schemaVersion": "1.0.0",
  "packageFamily": "ui-style-kit-css-icons",
  "requiredIconCount": 64,
  "naming": {
    "idCase": "kebab-case",
    "fileName": "<icon-id>.svg",
    "symbolId": "<style-prefix>-icon-<icon-id>",
    "cssClass": "<style-prefix>-icon",
    "aliasesAreBuildTimeOnly": true
  },
  "requiredExports": [
    "icons/<icon-id>.svg",
    "sprite/<pack-name>.inline.svg",
    "dist/<pack-name>.svg",
    "dist/<pack-name>.css",
    "manifest.json",
    "package.json",
    "README.md",
    "style-source/<style>-style-source.md"
  ],
  "requiredCssBehavior": [
    "All fills and strokes must resolve through UI Style Kit CSS variables.",
    "Inline SVG and inline sprite usage must support live style/theme changes.",
    "External image usage can be supported but is not the primary integration path.",
    "Every SVG must include title and desc metadata.",
    "Every style pack must ship the exact required icon IDs even when a style also has optional extras."
  ],
