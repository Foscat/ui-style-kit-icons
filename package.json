{
  "name": "ui-style-kit-icons",
  "version": "2.0.0",
  "description": "Theme-aware and monochrome SVG icons for the UI Style Kit ecosystem.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/ui-style-kit-icons.js",
  "module": "dist/ui-style-kit-icons.js",
  "types": "dist/ui-style-kit-icons.d.ts",
  "homepage": "https://foscat.github.io/ui-style-kit-icons/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Foscat/ui-style-kit-icons.git"
  },
  "bugs": {
    "url": "https://github.com/Foscat/ui-style-kit-icons/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "dist/ui-style-kit-icons.js",
    "dist/*.css",
    "paint/*.css"
  ],
  "scripts": {
    "build": "node scripts/build-dist.mjs",
    "assets:build": "node scripts/build-social-preview.mjs",
    "assets:check": "node scripts/check-collection.mjs",
    "contracts:write": "node scripts/sync-collection-contract.mjs",
    "coverage:build": "python scripts/build-coverage.py",
    "coverage:check": "python scripts/check-coverage.py",
    "demo": "node scripts/serve-demo.mjs",
    "demo:build": "python scripts/build-demo.py",
    "pages:build": "node scripts/build-pages.mjs",
    "check:js": "node scripts/check-js.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:consumer": "node scripts/check-consumer.mjs",
    "check:demo": "node scripts/demo-smoke.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:types": "tsc -p tests/types/tsconfig.json",
    "check:package": "node scripts/check-package.mjs",
    "format:check": "node scripts/format-check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/collection-assets.test.mjs tests/runtime-api.test.mjs tests/docs-links.test.mjs tests/pages-artifact.test.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "check": "npm run build && npm run assets:check && npm run coverage:check && npm run check:js && npm run check:types && npm run check:contracts && npm run pages:build && npm test && npm run format:check",
    "verify": "npm run check && npm run check:package && npm run check:consumer",
    "release:verify": "npm run verify && npm run check:demo && npm run check:release && npm audit --audit-level=moderate",
    "prepack": "npm run build && npm run assets:check && npm run check:js && npm run check:types && npm run check:contracts && npm run test:unit && npm run format:check",
    "prepublishOnly": "npm run release:verify"
  },
  "files": [
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "contract",
    "dist",
    "monochrome",
    "paint",
    "reference",
    "svg",
    "sprite",
    "manifest.json"
  ],
  "style": "dist/ui-style-kit-icons.css",
  "exports": {
    ".": {
      "types": "./dist/ui-style-kit-icons.d.ts",
      "import": "./dist/ui-style-kit-icons.js",
      "default": "./dist/ui-style-kit-icons.js"
    },
    "./element": {
      "types": "./dist/ui-style-kit-icons.d.ts",
      "import": "./dist/ui-style-kit-icons.js",
      "default": "./dist/ui-style-kit-icons.js"
    },
    "./runtime": {
      "types": "./dist/ui-style-kit-icons.d.ts",
      "import": "./dist/ui-style-kit-icons.js",
      "default": "./dist/ui-style-kit-icons.js"
    },
    "./registry": {
      "import": "./dist/registry.js",
      "default": "./dist/registry.js"
    },
    "./registry.js": {
      "import": "./dist/registry.js",
      "default": "./dist/registry.js"
    },
    "./registry.json": "./dist/registry.json",
    "./contract": "./contract/icon-contract.json",
    "./contract.json": "./contract/icon-contract.json",
    "./contract/*": "./contract/*",
    "./css": "./dist/ui-style-kit-icons.css",
    "./css.css": "./dist/ui-style-kit-icons.css",
    "./all.css": "./dist/ui-style-kit-icons.all.css",
    "./css/all": "./dist/ui-style-kit-icons.all.css",
    "./css/all.css": "./dist/ui-style-kit-icons.all.css",
    "./paint": "./dist/ui-style-kit-icons.css",
    "./paint.css": "./dist/ui-style-kit-icons.css",
    "./paint/*": "./paint/*",
    "./inline-svg": "./paint/inline-svg.mjs",
    "./dist/*": "./dist/*",
    "./sprite": "./dist/ui-style-kit-icons.svg",
    "./sprite.svg": "./dist/ui-style-kit-icons.svg",
    "./sprites/*": "./dist/sprites/*",
    "./inline-sprite": "./sprite/ui-style-kit-icons.inline.svg",
    "./inline-sprites/*": "./sprite/*",
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json",
    "./reference/*": "./reference/*",
    "./svg/*": "./svg/*",
    "./monochrome/*": "./monochrome/*"
  },
  "keywords": [
    "css",
    "icons",
    "svg",
    "ui-style-kit",
    "theme-aware",
    "cyberpunk",
    "monochrome",
    "icon-system"
  ],
  "peerDependencies": {
    "ui-style-kit-css": ">=2.7.1 <3"
  },
  "peerDependenciesMeta": {
    "ui-style-kit-css": {
      "optional": true
    }
  },
  "devDependencies": {
    "playwright": "1.62.0",
    "typescript": "7.0.2",
    "ui-style-kit-css": "2.7.1"
  },
  "license": "MIT"
}
