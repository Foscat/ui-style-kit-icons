{
  "name": "ui-style-kit-icons",
  "version": "1.0.0",
  "description": "Theme-aware SVG icon library for ui-style-kit-css and layout-style-css projects.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/ui-style-kit-icons.js",
  "module": "dist/ui-style-kit-icons.js",
  "types": "dist/ui-style-kit-icons.d.ts",
  "homepage": "https://foscat.github.io/ui-style-kit-css-icons/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Foscat/ui-style-kit-css-icons.git"
  },
  "bugs": {
    "url": "https://github.com/Foscat/ui-style-kit-css-icons/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "dist/ui-style-kit-icons.js",
    "dist/*.css",
    "packs/**/*.css"
  ],
  "scripts": {
    "build": "node scripts/build-dist.mjs",
    "assets:build": "node scripts/build-brand-assets.mjs",
    "demo": "node scripts/serve-demo.mjs",
    "pages:build": "node scripts/build-pages.mjs",
    "check:js": "node scripts/check-js.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:consumer": "node scripts/check-consumer.mjs",
    "check:demo": "node scripts/demo-smoke.mjs",
    "check:ecosystem": "node scripts/check-ecosystem.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:svg": "node scripts/check-svg-visuals.mjs",
    "check:types": "tsc -p tests/types/tsconfig.json",
    "check:package": "node scripts/check-package.mjs",
    "format:check": "node scripts/format-check.mjs",
    "pack:audit": "node scripts/pack-audit.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/docs-links.test.mjs tests/package-integrity.test.mjs tests/preview-html.test.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "check": "npm run build && npm run pack:audit && npm run check:js && npm run check:types && npm run check:contracts && npm run check:ecosystem && npm run check:svg && npm run pages:build && npm test && npm run format:check",
    "verify": "npm run check && npm run check:package && npm run check:consumer",
    "release:verify": "npm run verify && npm run check:demo && npm run check:release && npm audit --audit-level=moderate",
    "prepack": "npm run build && npm run pack:audit && npm run check:js && npm run check:types && npm run check:contracts && npm run check:ecosystem && npm run test:unit && npm run format:check",
    "prepublishOnly": "npm run release:verify"
  },
  "files": [
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "contract",
    "dist",
    "icons",
    "packs/*/LICENSE",
    "packs/*/README.md",
    "packs/*/dist/**",
    "packs/*/icons/**",
    "packs/*/manifest.json",
    "packs/*/package.json",
    "packs/*/sprite/**",
    "packs/*/style-source/**",
    "sprite",
    "style-source",
    "manifest.json"
  ],
  "style": "dist/ui-style-kit-icons.css",
  "exports": {
    ".": {
      "types": "./dist/ui-style-kit-icons.d.ts",
      "import": "./dist/ui-style-kit-icons.js",
      "default": "./dist/ui-style-kit-icons.js"
    },
    "./element": {
      "types": "./dist/ui-style-kit-icons.d.ts",
      "import": "./dist/ui-style-kit-icons.js",
      "default": "./dist/ui-style-kit-icons.js"
    },
    "./runtime": {
      "types": "./dist/ui-style-kit-icons.d.ts",
      "import": "./dist/ui-style-kit-icons.js",
      "default": "./dist/ui-style-kit-icons.js"
    },
    "./registry": {
      "import": "./dist/registry.js",
      "default": "./dist/registry.js"
    },
    "./registry.js": {
      "import": "./dist/registry.js",
      "default": "./dist/registry.js"
    },
    "./registry.json": "./dist/registry.json",
    "./contract": "./contract/icon-contract.json",
    "./contract.json": "./contract/icon-contract.json",
    "./contract/*": "./contract/*",
    "./css": "./dist/ui-style-kit-icons.css",
    "./css.css": "./dist/ui-style-kit-icons.css",
    "./all.css": "./dist/ui-style-kit-icons.all.css",
    "./css/all": "./dist/ui-style-kit-icons.all.css",
    "./css/all.css": "./dist/ui-style-kit-icons.all.css",
    "./dist/*": "./dist/*",
    "./sprite": "./dist/ui-style-kit-icons.svg",
    "./sprite.svg": "./dist/ui-style-kit-icons.svg",
    "./inline-sprite": "./sprite/ui-style-kit-icons.inline.svg",
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json",
    "./style-source/*": "./style-source/*",
    "./icons/*": "./icons/*",
    "./packs/*": "./packs/*"
  },
  "keywords": [
    "css",
    "icons",
    "svg",
    "ui-style-kit",
    "theme-aware",
    "cyberpunk",
    "synthwave"
  ],
  "peerDependencies": {
    "ui-style-kit-css": ">=2.1.0 <3"
  },
  "peerDependenciesMeta": {
    "ui-style-kit-css": {
      "optional": true
    }
  },
  "devDependencies": {
    "layout-style-css": "2.1.0",
    "playwright": "1.62.0",
    "typescript": "7.0.2",
    "ui-style-kit-css": "2.1.0"
  },
  "license": "MIT"
}
